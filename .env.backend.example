# Провайдер: deepseek или ollama
ANALYSIS_PROVIDER=deepseek
ANALYSIS_MODEL=deepseek-flash
# Ключ доступа расширения к вашему backend; сгенерируйте отдельно: openssl rand -hex 32
ANALYSIS_API_TOKEN=CHANGE_ME
# Ключ DeepSeek с platform.deepseek.com; только на backend, не в расширении
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_KEY_HERE
# Нужен только при ANALYSIS_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
