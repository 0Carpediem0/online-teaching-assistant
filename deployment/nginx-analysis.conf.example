# Замените имя сервера и пути к сертификату перед включением.
server {
    listen 443 ssl;
    server_name analysis.example.edu;

    ssl_certificate /etc/ssl/analysis/fullchain.pem;
    ssl_certificate_key /etc/ssl/analysis/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 10s;
        proxy_read_timeout 130s;
        client_max_body_size 512k;
    }
}
