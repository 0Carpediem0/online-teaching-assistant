{
  "manifest_version": 3,
  "name": "Ассистент преподавателя",
  "version": "0.1.0",
  "action": {"default_title":"Ассистент преподавателя", "default_popup":"popup.html"},
  "description": "Панель управления занятием в Яндекс Телемосте.",
  "background": {"service_worker":"background.js"},
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html",
  "minimum_chrome_version": "120",
  "content_scripts": [{
    "matches": ["https://telemost.yandex.ru/*"],
    "js": ["device-probe.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true,
    "match_origin_as_fallback": true
  }, {
    "matches": ["https://telemost.yandex.ru/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
